APP_ENV=development
# Docker Compose uses PostgreSQL. For local SQLite, unset DATABASE_URL.
DATABASE_URL=postgresql+psycopg://jobhunter:change-me@db:5432/jobhunter
REDIS_URL=redis://redis:6379/0
DISCOVERY_INTERVAL_SECONDS=120
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Adzuna API credentials for India/US aggregator searches.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
DEFAULT_COUNTRY=India
INDIA_MIN_CTC_LPA=15
